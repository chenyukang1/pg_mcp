PG_TEST_DATABASE_URL=postgresql://test_reader@db.example.test/assets_test
PG_TEST_EXPECTED_DATABASE=assets_test
PG_TEST_EXPECTED_USER=test_reader
PG_TEST_MAX_CONCURRENT=8
PG_TEST_QUERY_TIMEOUT_MS=10000
# 填写后才会启动生产只读实例
PG_PROD_RO_DATABASE_URL=
PG_PROD_RO_EXPECTED_DATABASE=
PG_PROD_RO_EXPECTED_USER=
PG_PROD_RO_MAX_CONCURRENT=2
PG_PROD_RO_QUERY_TIMEOUT_MS=5000
# --single 和 --stdio 默认使用测试库
ASSETS_DATABASE_URL=${PG_TEST_DATABASE_URL}
PG_MCP_EXPECTED_DATABASE=${PG_TEST_EXPECTED_DATABASE}
PG_MCP_EXPECTED_USER=${PG_TEST_EXPECTED_USER}
ASSETS_PG_SCHEMA=public
